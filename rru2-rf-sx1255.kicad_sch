				(size 5.08 5.08)
				(thickness 1.016)
				(bold yes)
				(color 200 0 0 1)
			)
			(justify right top)
		)
		(uuid "92b11b67-66e2-459d-ade8-4c598963b5d1")
	)
	(text "PLL supply: +3V3_RF through a ferrite bead.\nAVDD: 100 nF + 10 pF. DVDD: 100 nF + 10 pF.\nVP: 100 nF. Put each capacitor near its pin."
		(exclude_from_sim no)
		(at 324.866 88.392 0)
		(effects
