	(text "Preliminary M.2 key E pinout (standard names in brackets)\n\nUsed now:\n  8 I2S_BCLK (PCM_CLK), 10 I2S_WS (PCM_SYNC)\n  12 I2S_RX (PCM_IN), 14 I2S_TX (PCM_OUT)\n  9 SPI_SCK (SDIO_CLK), 11 SPI_MOSI (SDIO_CMD)\n  13 SPI_MISO (SDIO_DATA0), 15 SX_CS (SDIO_DATA1)\n  23 SX_RESET (SDIO_RESET), 38 ID_SD, 40 ID_SC (VENDOR_DEFINED)\n  17 ATT_LE1 (SDIO_DATA2), 19 ATT_LE2 (SDIO_DATA3), 54 ATT_LE3 (W_DISABLE2)\n  56 PLL_LE (W_DISABLE1), 62 PLL_MUXOUT (ALERT), 50 REF_10M (SUSCLK)\n\nReserved:\n  44 PPS (COEX3)\n  58 I2C_SDA, 60 I2C_SCL (no pull-ups on the card)\n  22 UART_RX, 32 UART_TX"
		(exclude_from_sim no)
		(at 129.54 64.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3bbe54db-4bfa-40ec-a1c7-078979d20a89")
	)
